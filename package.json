{
  "name": "magic-brain",
  "version": "1.0.0",
  "description": "Magic Brain — intelligence for Magic: The Gathering collectors and investors.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node --env-file-if-exists=.env.local scripts/deploy-cloudflare.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:sync-reserved": "node --env-file=.env.local scripts/sync-reserved-list.mjs"
  },
  "keywords": [
    "magic-the-gathering",
    "portfolio",
    "card-prices"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
