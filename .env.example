# Create a restricted test key with only the permissions needed for
# Checkout Sessions, Customers, Prices, and Subscriptions.
STRIPE_RESTRICTED_KEY=rk_test_replace_me

# Create the €5/month recurring Brain Pro Price in Stripe.
STRIPE_PRO_PRICE_ID=price_replace_me

# Generated by Stripe CLI when forwarding local webhook events.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth web application credentials.
# Authorized redirect URIs:
# http://localhost:3000/api/auth/callback/google
# https://magicbrain.es/api/auth/callback/google
AUTH_GOOGLE_ID=replace_with_google_client_id
AUTH_GOOGLE_SECRET=replace_with_google_client_secret

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_random_32_byte_secret

# Your approved Cardmarket referral identifier, if applicable.
NEXT_PUBLIC_CARDMARKET_REFERRER=your_cardmarket_username
