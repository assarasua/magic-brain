# Local PostgreSQL database. Do not point contributor environments at production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magic_brain
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Required for stable Auth.js sessions. Generate locally with:
# openssl rand -base64 32
AUTH_SECRET=

# Optional Google OAuth app for local sign-in. Use this redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional Stripe sandbox configuration. Use restricted keys only.
STRIPE_RESTRICTED_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional approved Cardmarket referral identifier. This value is public.
NEXT_PUBLIC_CARDMARKET_REFERRER=
