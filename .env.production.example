# Public production URL
NEXT_PUBLIC_APP_URL=https://magicbrain.es
AUTH_URL=https://magicbrain.es

# Google OAuth web application credentials
# Authorized JavaScript origin: https://magicbrain.es
# Authorized redirect URI: https://magicbrain.es/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# MCP OAuth resource-server integration. Generate independent random secrets
# and configure the same values as encrypted Worker secrets.
MAGIC_BRAIN_MCP_RESOURCE_URL=https://magic-brain-mcp.assarasua.workers.dev/mcp
MAGIC_BRAIN_API_RESOURCE_URL=https://magicbrain.es/api/v1
MAGIC_BRAIN_MCP_INTROSPECTION_CLIENT_ID=magic-brain-mcp
MAGIC_BRAIN_MCP_INTROSPECTION_SECRET=
MAGIC_BRAIN_MCP_DELEGATION_SECRET=

# Production services
DATABASE_URL=
NEXT_PUBLIC_CARDMARKET_REFERRER=

# Server-only. Enable gradually after real-data promotion and successful scoring.
ML_RANKING_EXPERIMENT_ENABLED=false
ML_RANKING_COHORT_PERCENT=0
