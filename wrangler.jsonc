{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "magic-brain",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"build": {
		"command": "npx --no-install opennextjs-cloudflare build"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "magicbrain.es",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "4e073b9c05f94a81ad18bba6ac32ad5e"
		}
	],
	"ratelimits": [
		{
			"name": "PUBLIC_API_ANONYMOUS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_API_KEY_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 300,
				"period": 60
			}
		}
	]
}