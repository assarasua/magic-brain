# Base URL must include the public API version and a trailing slash.
MAGIC_BRAIN_API_BASE_URL=https://magicbrain.es/api/v1/

# Optional server-side API key for a higher public-API quota. Never expose it
# in MCP configuration or return it from tools.
MAGIC_BRAIN_API_KEY=

MAGIC_BRAIN_API_TIMEOUT_MS=8000
MAGIC_BRAIN_MAX_RESPONSE_BYTES=524288
MAGIC_BRAIN_MAX_TOOL_CHARS=90000

MCP_PORT=8788
MCP_BIND_HOST=127.0.0.1

# Hostnames only. Set this to the deployed MCP hostname behind your proxy.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional comma-separated full origins. Requests without Origin are allowed;
# browser requests with an Origin are denied unless listed here.
MCP_ALLOWED_ORIGINS=
